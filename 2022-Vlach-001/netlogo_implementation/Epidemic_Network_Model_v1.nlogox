      <pen interval="1.0" mode="0" display="Contag" color="-2674135" legend="true">
        <setup></setup>
        <update>plot count people with [contag? = true]</update>
      </pen>
      <pen interval="1.0" mode="0" display="Incubation" color="-6459832" legend="true">
        <setup></setup>
        <update>plot count people with [incubation? = true]</update>
      </pen>
      <pen interval="1.0" mode="0" display="Infected" color="-13345367" legend="true">
        <setup></setup>
        <update>plot count people with [incubation? = true or contag? = true or prodromal? = true]</update>
      </pen>
    </plot>
    <slider x="1048" step="1" y="423" max="100" width="174" display="spread-rate" height="50" min="0" direction="Horizontal" default="25.0" variable="spread-rate" units="%"></slider>
    <slider x="1329" step="1" y="434" max="100" width="174" display="mortality-rate" height="50" min="0" direction="Horizontal" default="20.0" variable="mortality-rate" units="%"></slider>
    <monitor x="1414" precision="17" y="75" height="60" fontSize="11" width="100" display="latent">count people with [incubation? = true]</monitor>
    <monitor x="1519" precision="17" y="75" height="60" fontSize="11" width="100" display="prodromal">count people with [prodromal? = true]</monitor>
    <monitor x="1624" precision="17" y="75" height="60" fontSize="11" width="100" display="contagious">count people with [contag? = true]</monitor>
    <monitor x="1739" precision="17" y="75" height="60" fontSize="11" width="100" display="recovered">count people with [recovered? = true]</monitor>
    <plot x="1489" autoPlotX="true" yMax="10.0" autoPlotY="true" y="862" xMin="2.0" height="175" legend="false" xMax="30.0" yMin="0.0" width="273" display="Household population size">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>histogram [household-pop] of patches with [house? = true]</update>
      </pen>
    </plot>
    <monitor x="1385" precision="17" y="140" height="60" fontSize="11" width="100" display="Count">count links</monitor>
    <monitor x="1529" precision="2" y="10" height="60" fontSize="11" width="100" display="dens/km2">count people / 400</monitor>
    <monitor x="1852" precision="1" y="75" height="60" fontSize="11" width="100" display="susceptible">count people with [susceptible? = true]</monitor>
    <monitor x="1199" precision="17" y="10" height="60" fontSize="11" width="129" display="Actual process">process</monitor>
    <slider x="974" step="1" y="464" max="10" width="150" display="initial-infected" height="50" min="1" direction="Horizontal" default="10.0" variable="initial-infected"></slider>
    <button x="1892" y="192" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="72" display="Hide links">ask links
  [set hidden? true]</button>
    <monitor x="1632" precision="1" y="10" height="60" fontSize="11" width="100" display="Died%">count people with [died? = true] / (count people / 100)</monitor>
    <button x="1697" y="245" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="72" display="Unhide links">ask links
  [set hidden? false]</button>
    <button x="1687" y="290" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="99" display="Hide recovered">ask people with [recovered? = true or died? = true]
   [set hidden? true]</button>
    <plot x="975" autoPlotX="true" yMax="10.0" autoPlotY="true" y="1096" xMin="0.0" height="191" legend="true" xMax="10.0" yMin="0.0" width="509" display="Population">
      <setup></setup>
      <update></update>
