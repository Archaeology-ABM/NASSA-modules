    <monitor x="2506" precision="2" y="10" height="60" fontSize="11" width="100" display="%">neg-spread / (count-spread / 100)</monitor>
    <slider x="1505" step="0.5" y="232" max="10" width="172" display="duration-latent-stddev" height="50" min="1" direction="Horizontal" default="3.0" variable="duration-latent-stddev"></slider>
    <slider x="1503" step="0.5" y="287" max="10" width="172" display="duration-prodromal-stddev" height="50" min="1" direction="Horizontal" default="2.0" variable="duration-prodromal-stddev"></slider>
    <slider x="1503" step="0.5" y="342" max="10" width="175" display="duration-contagious-stddev" height="50" min="1" direction="Horizontal" default="3.0" variable="duration-contagious-stddev"></slider>
    <plot x="975" autoPlotX="true" yMax="5.0" autoPlotY="true" y="1292" xMin="0.0" height="191" legend="true" xMax="10.0" yMin="0.0" width="507" display="Infected contacts">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Contacts" color="-16777216" legend="true">
        <setup></setup>
        <update>if any? people with [contag? = true] [plot count-daily-contact]</update>
      </pen>
    </plot>
    <plot x="2110" autoPlotX="true" yMax="10.0" autoPlotY="true" y="95" xMin="0.0" height="175" legend="false" xMax="50.0" yMin="0.0" width="266" display="Whole illness">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update><![CDATA[histogram [ill-duration] of people with [ill-duration > 0]]]></update>
      </pen>
    </plot>
    <plot x="1986" autoPlotX="true" yMax="10.0" autoPlotY="true" y="275" xMin="0.0" height="175" legend="false" xMax="25.0" yMin="0.0" width="266" display="Latent">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update><![CDATA[histogram [ill-duration-l] of people with [ill-duration-l > 0]]]></update>
      </pen>
    </plot>
