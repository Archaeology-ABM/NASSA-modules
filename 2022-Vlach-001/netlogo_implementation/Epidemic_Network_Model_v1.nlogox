    <slider x="1339" step="1" y="233" max="20" width="159" display="duration-latent-mean" height="50" min="1" direction="Horizontal" default="12.0" variable="duration-latent-mean"></slider>
    <slider x="1340" step="1" y="288" max="20" width="160" display="duration-prodromal-mean" height="50" min="1" direction="Horizontal" default="3.0" variable="duration-prodromal-mean"></slider>
    <slider x="1339" step="1" y="343" max="20" width="159" display="duration-contagious-mean" height="50" min="1" direction="Horizontal" default="9.0" variable="duration-contagious-mean"></slider>
