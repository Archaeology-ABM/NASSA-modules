    <slider x="975" step="5" y="189" max="50" width="150" display="initial-clusters" height="50" min="5" direction="Horizontal" default="30.0" variable="initial-clusters"></slider>
    <slider x="975" step="1" y="244" max="cluster-radius-max" width="150" display="cluster-radius-min" height="50" min="1" direction="Horizontal" default="5.0" variable="cluster-radius-min"></slider>
